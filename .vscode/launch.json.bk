{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": "./build/Debug/${workspaceFolderBasename}.elf",
            "request": "launch",
            "interface": "swd",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "configFiles": [
                "interface/stlink.cfg",
                "board/stm32h7x_bambloo.cfg"
            ],
            "serverArgs": [
                "-d"
            ],
            "showDevDebugOutput": "raw",
            "overrideLaunchCommands": [
                "monitor reset init",
                "-target-download",
                "monitor reset halt"
            ],
            "servertype": "openocd",
            "device": "stm32h753xih6",
            "svdFile": "C:\\Users\\liugc\\AppData\\Local\\Arm\\Packs\\Keil\\STM32H7xx_DFP\\4.1.0\\CMSIS\\SVD\\STM32H753.svd",
        }
    ]
}